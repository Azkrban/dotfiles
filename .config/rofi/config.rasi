configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 14";
    display-drun: " Apps: ";
    display-run: " Run";
    display-window: " Window";
    drun-display-format: "{name}";
    location: 0;
    xoffset: 0;
    yoffset: 0;
    timeout {
        action: "kb-cancel";
        delay:  0;
    }
    filebrowser {
        directories-first: true;
        sorting-method:    "name";
    }
}

@theme "mytheme"